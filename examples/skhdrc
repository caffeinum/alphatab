# run-or-raise setup
# source: https://www.willharris.dev/garden/run-or-raise
# helpers: github.com/caffeinum/alphatab
#
# raycast remaps caps lock to ctrl + alt + shift + cmd, a combination no
# application uses, so these never collide with anything.
#
# caps lock is under the left pinky, so the bindings live under the RIGHT hand
# — hold with the left, strike with the right, no one-handed claw. right hand
# rests on jkl;, so the block is the 3x3 around it plus the row above:
#
#     7 helium·you      8 helium·2027   9 cheatsheet
#     u superconductor  i messages      o chatgpt
#     j next app        k prev app      l cmux
#     m superhuman      , safari        . telegram
#
# mnemonics survive where they can: i=imessage, m=mail, o=openai, j/k=vim.

# ── row 7 · browsers + help ─────────────────────────────────────────────────
# `open -b` raises the last-focused window and ignores the profile;
# `--profile-directory` always spawns a new window. helium-raise finds the
# profile's existing window through the accessibility api and raises that,
# launching only when there isn't one.
ctrl + alt + shift + cmd - 7 : ~/.local/bin/helium-raise "Default"
ctrl + alt + shift + cmd - 8 : ~/.local/bin/helium-raise "Profile 1"
ctrl + alt + shift + cmd - 9 : CHEATSHEET_BROWSER=net.imput.helium ~/.local/bin/skhd-cheatsheet

# ── row u ───────────────────────────────────────────────────────────────────
ctrl + alt + shift + cmd - u : /usr/bin/open -b com.zarifpour.superconductor
ctrl + alt + shift + cmd - i : /usr/bin/open -b com.apple.MobileSMS
ctrl + alt + shift + cmd - o : /usr/bin/open -b com.openai.codex

# ── home row · navigation + terminal ────────────────────────────────────────
# j/k are next/prev the vim way, under the index and middle fingers where the
# hand already rests. alphabetical rather than ⌘tab's most-recently-used order,
# so an app stays the same number of presses away instead of shuffling.
ctrl + alt + shift + cmd - j : ~/.local/bin/alphatab next
ctrl + alt + shift + cmd - k : ~/.local/bin/alphatab prev
ctrl + alt + shift + cmd - l : /usr/bin/open -b com.cmuxterm.app

# ── bottom row ──────────────────────────────────────────────────────────────
ctrl + alt + shift + cmd - m : /usr/bin/open -b com.superhuman.electron
ctrl + alt + shift + cmd - 0x2B : /usr/bin/open -b com.apple.Safari
ctrl + alt + shift + cmd - 0x2F : /usr/bin/open -b org.telegram.desktop

# ── aliases · earlier layouts, still wired ──────────────────────────────────
# the block above is the one worth learning, but these are already in the
# fingers. trailing `# alias` is a shell comment skhd passes through harmlessly,
# and the cheatsheet renders anything marked with it as secondary.

# the left-hand block this replaced
ctrl + alt + shift + cmd - 1 : ~/.local/bin/helium-raise "Default" # alias
ctrl + alt + shift + cmd - 2 : ~/.local/bin/helium-raise "Profile 1" # alias
ctrl + alt + shift + cmd - 3 : CHEATSHEET_BROWSER=net.imput.helium ~/.local/bin/skhd-cheatsheet # alias
ctrl + alt + shift + cmd - q : /usr/bin/open -b com.openai.codex # alias
ctrl + alt + shift + cmd - w : /usr/bin/open -b com.apple.Safari # alias
ctrl + alt + shift + cmd - e : /usr/bin/open -b com.superhuman.electron # alias
ctrl + alt + shift + cmd - a : ~/.local/bin/alphatab prev # alias
ctrl + alt + shift + cmd - s : /usr/bin/open -b com.zarifpour.superconductor # alias
ctrl + alt + shift + cmd - d : ~/.local/bin/alphatab next # alias
ctrl + alt + shift + cmd - z : /usr/bin/open -b org.telegram.desktop # alias
ctrl + alt + shift + cmd - x : /usr/bin/open -b com.apple.MobileSMS # alias
ctrl + alt + shift + cmd - c : /usr/bin/open -b com.cmuxterm.app # alias

# the original mnemonic keys
ctrl + alt + shift + cmd - h : ~/.local/bin/helium-raise "Default" # alias
ctrl + alt + shift + cmd - f : /usr/bin/open -b com.apple.Safari # alias
ctrl + alt + shift + cmd - g : /usr/bin/open -b com.openai.codex # alias
ctrl + alt + shift + cmd - t : /usr/bin/open -b org.telegram.desktop # alias
ctrl + alt + shift + cmd - 0x2C : CHEATSHEET_BROWSER=net.imput.helium ~/.local/bin/skhd-cheatsheet # alias

# cmd - tab is swallowed on purpose: forces muscle memory onto the block above
# instead of falling back to the app switcher.
# `true` is a no-op; skhd's event tap eats the keypress before the Dock.
cmd - tab : true
cmd + shift - tab : true
